# ============================================================
# Application
# ============================================================

# Required. A strong random string used for cryptographic signing.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# Base URL of the app, used in outbound email links.
APP_HOST=http://localhost:8000

# ============================================================
# Database
# ============================================================

# Required. Full PostgreSQL connection string.
# When running locally: use localhost.
# When running via docker-compose: the DATABASE_URL is overridden
# automatically to use the internal "db" hostname — see docker-compose.yml.
DATABASE_URL=postgresql://user:password@localhost:5432/macro_agents

# Required by docker-compose to configure the PostgreSQL service.
POSTGRES_USER=macro
POSTGRES_PASSWORD=macro
POSTGRES_DB=macro_agents

# ============================================================
# Anthropic API
# ============================================================

# Required for all LLM workflows and the intake conversation.
# Obtain at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ============================================================
# FRED API
# ============================================================

# Required for MacroContextWorkflow, HistoricalAnalogWorkflow, and BacktestWorkflow.
# Free API key at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your-fred-api-key

# ============================================================
# IBKR Client Portal API
# ============================================================

# Required for execution, market data, and news feed polling.
# For local dev (outside Docker): point to the gateway running on your machine.
# Inside Docker Compose this is overridden automatically to https://ibeam:5000.
IBKR_BASE_URL=https://localhost:5000

# Your IBKR live account ID (used when trading_mode = real)
IBKR_ACCOUNT_ID=your-ibkr-account-id

# Your IBKR paper account ID (used when trading_mode = paper)
IBKR_PAPER_ACCOUNT_ID=your-ibkr-paper-account-id

# ibeam credentials — used by the ibeam Docker service to authenticate the
# Client Portal gateway automatically. Not used by the app itself.
IBKR_USERNAME=your-ibkr-username
IBKR_PASSWORD=your-ibkr-password


# ============================================================
# Email / SMTP (for alert delivery)
# ============================================================

# Required for falsification condition alerts and trade confirmations.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-smtp-app-password
SMTP_FROM=your-email@example.com

# Destination address for all system alerts.
ALERT_EMAIL=alerts@example.com
